{
  "name": "aerovia-inspector-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Demo web de AEROVIA INSPECTOR: inspección técnica con drones y recorrido 3D controlado por scroll.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4174 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "e2e": "node e2e/run.mjs",
    "stills": "node scripts/render-stills.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@react-three/fiber": "9.8.1",
    "gsap": "3.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/inter-tight": "5.3.0",
    "@fontsource/source-serif-4": "5.3.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "puppeteer-core": "25.13.0",
    "three-gpu-pathtracer": "0.0.27",
    "three-mesh-bvh": "0.9.16",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
